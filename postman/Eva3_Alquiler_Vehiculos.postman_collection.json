    {
      "name": "1. Clientes (8081)",
      "item": [
        {
          "name": "Registrar cliente (válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clienteUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{dni}}\",\n  \"nombres\": \"Diego\",\n  \"apellidos\": \"Panez Rondinel\",\n  \"correo\": \"{{correo}}\",\n  \"telefono\": \"987654321\",\n  \"numeroLicencia\": \"{{licencia}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos únicos en cada ejecución para que la colección se pueda correr varias veces",
                  "const n = () => Math.floor(Math.random() * 10);",
                  "let dni = \"\"; for (let i = 0; i < 8; i++) dni += n();",
                  "let lic = \"Q\"; for (let i = 0; i < 8; i++) lic += n();",
                  "pm.collectionVariables.set(\"dni\", dni);",
                  "pm.collectionVariables.set(\"licencia\", lic);",
                  "pm.collectionVariables.set(\"correo\", \"cliente\" + Date.now() + \"@correo.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set(\"idCliente\", c.id);",
                  "pm.test(\"Devuelve el id y la cabecera Location\", () => { pm.expect(c.id).to.be.a(\"number\"); pm.response.to.have.header(\"Location\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clienteUrl}}/api/clientes"
          },
          "event": [
