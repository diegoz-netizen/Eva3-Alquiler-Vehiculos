    {
      "name": "3. Alquileres (8083)",
      "item": [
        {
          "name": "Registrar alquiler (válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{alquilerUrl}}/api/alquileres",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": {{idCliente}},\n  \"idVehiculo\": {{idVehiculo}},\n  \"fechaInicio\": \"{{manana}}\",\n  \"fechaFin\": \"{{en4dias}}\",\n  \"tarifaDiaria\": 150.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fechas relativas a hoy, así la colección siempre es válida",
                  "const f = d => { const x = new Date(); x.setDate(x.getDate() + d); return x.toISOString().slice(0, 10); };",
                  "pm.collectionVariables.set(\"manana\", f(1));",
                  "pm.collectionVariables.set(\"en4dias\", f(4));",
                  "pm.collectionVariables.set(\"en6dias\", f(6));",
                  "pm.collectionVariables.set(\"ayer\", f(-1));",
                  "pm.collectionVariables.set(\"en30dias\", f(30));",
                  "pm.collectionVariables.set(\"en32dias\", f(32));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const a = pm.response.json();",
                  "pm.collectionVariables.set(\"idAlquiler\", a.id);",
                  "pm.test(\"Calcula 3 días\", () => pm.expect(a.dias).to.eql(3));",
                  "pm.test(\"Importe = 3 x 150 = 450\", () => pm.expect(Number(a.importeEstimado)).to.eql(450));",
                  "pm.test(\"Nace ACTIVO\", () => pm.expect(a.estado).to.eql(\"ACTIVO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "ERROR: fecha fin antes que la de inicio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
